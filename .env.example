# Optional Gemini API key for the hosted conversational assistant.
# Leave blank to use the built-in read-only local help responses.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional: set AI_IOT_DB_PATH to a durable local path for the SQLite database.
# AI_IOT_DB_PATH=

# Group nearby matching gateway detections into one incident (seconds; default 300).
# IOT_INCIDENT_DEDUPE_SECONDS=300

# Optional gateway bearer token. When set, requests must send Authorization: Bearer <token>.
# Keep the gateway bound to localhost unless deployed behind authenticated HTTPS.
# IOT_GATEWAY_TOKEN=
